        <mxCell id="act_submit" parent="lane_requester" style="rounded=1;arcSize=30;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="Fill form and submit request" vertex="1">

<mxfile host="app.diagrams.net" pages="1">
  <diagram id="state-machine-template" name="Record Status States">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2160" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer UML Frame -->
        <mxCell id="frame" parent="1" style="shape=umlFrame;whiteSpace=wrap;width=420;height=35;container=0;collapsible=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="Record Status States" vertex="1">
          <mxGeometry x="20" y="20" width="2060" height="780" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="start" parent="1" style="ellipse;aspect=fixed;fillColor=#000000;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;" value="" vertex="1">
          <mxGeometry x="1040" y="100" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- States -->
        <mxCell id="st_active" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="ACTIVE" vertex="1">
          <mxGeometry x="940" y="300" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_cancelled" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="CANCELLED" vertex="1">
          <mxGeometry x="480" y="560" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_completed" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="COMPLETED" vertex="1">
          <mxGeometry x="940" y="560" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_expired" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="EXPIRED" vertex="1">
          <mxGeometry x="1400" y="560" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Terminal End Nodes -->
        <mxCell id="end_cancelled" parent="1" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;backgroundOutline=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;" value="" vertex="1">
          <mxGeometry x="580" y="700" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="end_completed" parent="1" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;backgroundOutline=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;" value="" vertex="1">
          <mxGeometry x="1040" y="700" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="end_expired" parent="1" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;backgroundOutline=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=14;" value="" vertex="1">
          <mxGeometry x="1500" y="700" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Side-Gutter Notes -->
        <mxCell id="note_0" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;size=25;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="In-place metadata updates require&#10;an ACTIVE record before deadline&#10;and preserve original ID and slot." vertex="1">
          <mxGeometry x="40" y="260" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note_1" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;size=25;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;" value="All terminal states are immutable.&#10;Manual overrides are prohibited;&#10;corrections create new records." vertex="1">
          <mxGeometry x="1720" y="520" width="320" height="140" as="geometry" />
        </mxCell>

        <!-- Transitions (unique ports, jumpStyle=arc) -->
        <mxCell id="t_0" edge="1" parent="1" source="start" target="st_active" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;labelWidth=240;spacing=4;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="create [rules and slot valid] /&#10;persist record atomically">
          <mxGeometry relative="1" x="-0.2" as="geometry" />
        </mxCell>
        <mxCell id="t_1" edge="1" parent="1" source="st_active" target="st_active" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;labelWidth=260;spacing=4;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="updateDetails [owner, ACTIVE,&#10;before deadline] / update fields">
          <mxGeometry relative="1" x="-0.15" as="geometry">
            <Array as="points">
              <mxPoint x="1340" y="340" />
              <mxPoint x="1340" y="250" />
              <mxPoint x="1120" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_2" edge="1" parent="1" source="st_active" target="st_cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;labelWidth=260;spacing=4;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="cancel [owner, ACTIVE, before&#10;deadline] / set CANCELLED">
          <mxGeometry relative="1" x="-0.3" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_3" edge="1" parent="1" source="st_active" target="st_completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;labelWidth=250;spacing=4;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="fulfill [authorized, ACTIVE] /&#10;commit COMPLETED atomically">
          <mxGeometry relative="1" x="-0.1" as="geometry" />
        </mxCell>
        <mxCell id="t_4" edge="1" parent="1" source="st_active" target="st_expired" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;labelWidth=250;spacing=4;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="maintenance [window closed and&#10;still ACTIVE] / set EXPIRED">
          <mxGeometry relative="1" x="-0.2" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="420" />
              <mxPoint x="1520" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t_5" edge="1" parent="1" source="st_cancelled" target="end_cancelled" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_6" edge="1" parent="1" source="st_completed" target="end_completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t_7" edge="1" parent="1" source="st_expired" target="end_expired" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;endArrow=open;endFill=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dashed Note Links -->
        <mxCell id="edge_note_0" edge="1" parent="1" source="st_active" target="note_0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;startArrow=none;endArrow=none;endFill=0;dashed=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=0.25;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="270" />
              <mxPoint x="400" y="270" />
              <mxPoint x="400" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_note_1" edge="1" parent="1" source="st_expired" target="note_1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;startArrow=none;endArrow=none;endFill=0;dashed=1;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#000000;strokeColor=#000000;labelBackgroundColor=#ffffff;labelBorderColor=none;whiteSpace=wrap;curved=0;orthogonal=1;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value="">
